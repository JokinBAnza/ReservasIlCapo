APP_NAME="Il Capo"
APP_ENV=production
APP_KEY=base64:xM4/Csv0adnjGeWcAXmkE1pBEJk92Yze2jMjBnbTLEQ=
APP_DEBUG=false
APP_URL=https://reservas.ilcapo.net

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ============================================================
# RELLENAR: datos de la base de datos MySQL que cree Arsys
# (los pasa la persona que gestiona el hosting)
# ============================================================
DB_CONNECTION=mysql
DB_HOST=RELLENAR_HOST_MYSQL
DB_PORT=3306
DB_DATABASE=RELLENAR_NOMBRE_BD
DB_USERNAME=RELLENAR_USUARIO_BD
DB_PASSWORD=RELLENAR_CONTRASENA_BD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# En hosting compartido no hay procesos en segundo plano:
# los trabajos se ejecutan al momento (sync)
QUEUE_CONNECTION=sync

CACHE_STORE=database

# ============================================================
# RELLENAR: cuenta SMTP de Brevo (gratis, 300 emails/dia)
# 1. Crear cuenta en brevo.com
# 2. Menu -> SMTP & API -> SMTP: ahi salen usuario y clave
# ============================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=RELLENAR_USUARIO_BREVO
MAIL_PASSWORD=RELLENAR_CLAVE_SMTP_BREVO
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="reservas@ilcapo.net"
MAIL_FROM_NAME="Il Capo"
